# 默认按文本处理，行尾保持仓库内一致
* text=auto

# 部署到 Linux 直接执行的脚本必须是 LF，否则报 $'\r': command not found
*.sh   text eol=lf
*.py   text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.json text eol=lf
*.md   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 批处理保持 CRLF
*.bat  text eol=crlf

# 二进制产物不要做行尾转换
*.bin  binary
*.rar  binary
*.zip  binary
*.sqlite3 binary
