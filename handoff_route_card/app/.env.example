# 复制成 /opt/route-card/.env，然后 chmod 600
# 这个文件不要进 git，不要发给别人。

# 腾讯位置服务 Key（WebServiceAPI 权限）。只活在服务器上，不进固件、不进仓库。
TENCENT_KEY=

# TiDB Link 注册 Connector 时只返回一次的 connectorKey。正式挂载前必填。
# 平台会在 initialize/tools/list/tools/call 的 Authorization: Bearer 头中携带它。
# 不配置时仅为本地/演示兼容模式：不做鉴权，并允许旧式 session_id 参数。
CONNECTOR_KEY=

# 服务监听端口。只绑 127.0.0.1，由 nginx 反代到公网。
PORT=8010

# sqlite 落地路径
DB_PATH=/opt/route-card/data/route_card.sqlite3
